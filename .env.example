# Copy this file to .env and fill in what you need. Variables already set in
# the shell take precedence over .env.
# Put comments on their own lines: text after a value becomes part of the value.

# Gemini API keys, comma-separated. Agent runs take them in turn; keys only add
# quota if they belong to different Google Cloud projects.
GEMINI_API_KEYS=

# Optional settings. Uncomment a line to change its default.

# A single key, used if GEMINI_API_KEYS is empty
# GEMINI_API_KEY=

# Gemini CLI executable [gemini]
# GEMINI_BIN=/path/to/gemini

# Model of the coding agent [gemini-3.1-pro-preview in the launch scripts]
# GEMINI_MODEL=gemini-3.1-pro-preview

# 1 = the Gemini agent may run shell commands while exploring [off; the launch
# scripts use EXPLORE_SHELL instead]
# GEMINI_EXPLORE_SHELL=1

# Interpreter for the evaluators and candidate programs [the one running DREAM-RSI]
# DRSI_EVAL_PYTHON=/path/to/python

# How each branch gets the earlier rounds: copy or symlink [copy]
# DRSI_HISTORY_SEED_MODE=copy

# Server list for the kb_* tasks [tasks/kernelbench/server_info.yaml]
# GPUKERNEL_SERVER_INFO=/path/to/server_info.yaml
